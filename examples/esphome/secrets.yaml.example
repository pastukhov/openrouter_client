# ESPHome secrets example
# Copy this file to secrets.yaml and fill in your values
# DO NOT commit secrets.yaml to version control!

wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"

# Generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "your_32_byte_base64_key_here"

ota_password: "your_ota_password"

# Get your API key from https://openrouter.ai/keys
openrouter_api_key: "sk-or-v1-your_openrouter_api_key_here"
